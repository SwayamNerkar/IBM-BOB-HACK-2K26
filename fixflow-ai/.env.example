# FixFlow AI environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# AI Provider: "openai", "groq", or "demo"
# Set to "demo" to use deterministic local responses (no API key required)
AI_PROVIDER=demo

# Your AI provider API key (leave empty to stay in demo mode)
AI_API_KEY=

# API endpoint URL
# OpenAI: https://api.openai.com/v1/chat/completions
# Groq:   https://api.groq.com/openai/v1/chat/completions
AI_API_URL=

# Model name
# OpenAI: gpt-4o-mini  or  gpt-4o
# Groq:   llama3-8b-8192  or  llama-3.1-8b-instant
AI_MODEL=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173

# Application environment: development or production
APP_ENV=development
